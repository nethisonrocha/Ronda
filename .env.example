# Copie para .env (fora do git) e troque as senhas. O mesmo arquivo serve à aplicação
# (variáveis lidas por src/ronda/config.py) e ao compose de desenvolvimento
# (docker compose -f deploy/compose/dev.yml --env-file .env ...).

# --- Aplicação ---------------------------------------------------------------------------
# desenvolvimento | teste | producao
RONDA_ENV=desenvolvimento
# Diretório com um arquivo <tenant>.yaml por organização.
RONDA_POLICIES_DIR=policies/examples

# --- Compose de desenvolvimento (deploy/compose/dev.yml) ---------------------------------
# Portas no host, presas em 127.0.0.1. Os padrões fogem de 5432-5434 e 6379-6381.
RONDA_PG_PORT=5435
RONDA_REDIS_PORT=6382
# Dono do banco e das migrations.
RONDA_PG_DB=ronda
RONDA_PG_USER=ronda
RONDA_PG_PASSWORD=troque-a-senha-do-dono
# Papel sem privilégios da aplicação (ronda_app), criado no primeiro boot do Postgres.
RONDA_APP_PASSWORD=troque-a-senha-da-aplicacao
RONDA_REDIS_PASSWORD=troque-a-senha-do-redis

# --- Conexões da aplicação ---------------------------------------------------------------
# Repetem as portas e senhas acima; o .env não interpola variáveis, então mantenha iguais.
# Para usar outro servidor, basta trocar estas três URLs.
RONDA_DATABASE_URL=postgresql+psycopg://ronda_app:troque-a-senha-da-aplicacao@127.0.0.1:5435/ronda
RONDA_DATABASE_MIGRATION_URL=postgresql+psycopg://ronda:troque-a-senha-do-dono@127.0.0.1:5435/ronda
RONDA_REDIS_URL=redis://:troque-a-senha-do-redis@127.0.0.1:6382/0

# --- Notificações ------------------------------------------------------------------------
# Bot do Telegram do Ronda (crie com o @BotFather; não use o bot do Paperclip).
RONDA_TELEGRAM_TOKEN=
# Chat id de cada tenant, com o nome que a política dele declara em notificacao.destino_env.
RONDA_TELEGRAM_CHAT_DEMO=
