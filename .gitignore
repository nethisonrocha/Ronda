!data/datasets.yaml

# Modelos do detector são baixados do HF Hub, nunca versionados.
detector/models/*
!detector/models/.gitkeep

# Tráfego real nunca entra no repositório; só amostras anonimizadas em samples/.
*.pcap
*.pcapng
!samples/**/*.pcap

node_modules/
.next/
*.crt
